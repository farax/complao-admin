# API (apps/api). Generate the three secrets with: npm run setup:admin
PORT=8787
STORE=dynamo                 # dynamo | memory
TABLE_NAME=complao-action-log
AWS_REGION=ap-southeast-2
# DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local
ADMIN_EMAIL=admin@complao.com
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
SESSION_HOURS=12
# Read-only user lookup (R15). POST {"ids": [...]} -> {"<id>": "<name>"}
USER_LOOKUP_URL=
USER_LOOKUP_TOKEN=
# Local only: DEMO=1 seeds a simulated log group; AUTH_DISABLED=1 skips sign-in (refused when NODE_ENV=production)
DEMO=0
AUTH_DISABLED=0
